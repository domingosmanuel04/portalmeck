APP_ENV=production
APP_URL=https://seu-dominio.com
APP_PORT=8080
APP_KEY=altere-para-uma-chave-longa-aleatoria

# Base de dados (cPanel/Plesk: use o host que o painel indicar, muitas vezes localhost)
DB_HOST=localhost
DB_PORT=3306
DB_HOST_PORT=3307
DB_DATABASE=nome_da_base
DB_USERNAME=utilizador_bd
DB_PASSWORD=password_forte_bd
DB_ROOT_PASSWORD=

RUN_MIGRATIONS=0

# Email (opcional)
MAIL_FROM=noreply@seu-dominio.com

# TURN / WebRTC (opcional — reuniões)
TURN_URL=turn:seu-dominio.com:3478
TURN_USERNAME=meck
TURN_PASSWORD=altere-turn-password

# Smoke tests (opcional)
# SMOKE_EMAIL=admin@mecklitter.com
# SMOKE_PASSWORD=password
